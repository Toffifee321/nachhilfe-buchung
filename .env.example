# Kopie als ".env" speichern und ausfüllen (".env" wird nie committet).
# Wird vom Befehl "flask" automatisch geladen (python-dotenv).
FLASK_APP=app
# Langer Zufallswert: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Lokal über http: 0. Im Internet (https): leer lassen oder 1.
COOKIE_SECURE=
# Nur hinter einem Proxy (PythonAnywhere): 1
TRUST_PROXY=
